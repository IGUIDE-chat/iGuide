{
  "$schema": "node_modules/wrangler/config-schema.json",
  "build": {
    "watch_dir": "src",
  },
  "compatibility_date": "2026-09-08",
  "main": "src/index.ts",
  "name": "ai-agent",
  "observability": {
    "enabled": true,
  },
  "placement": {
    "mode": "smart",
  },
  "rules": [
    {
      "fallthrough": true,
      "globs": ["**/*.md"],
      "type": "Text",
    },
  ],
  "vars": {
    "EMBEDDING_DIMENSIONS": "384",
    "EMBEDDING_MODEL": "multilingual-e5-small",
    "USE_TOOL_USE_RAG": "false",
  },
}
