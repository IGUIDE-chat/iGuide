{
  "name": "@iguide/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:dorm-media": "npx tsx scripts/audit-dorm-media.ts",
    "build": "vp build",
    "dev": "vp dev",
    "generate:qmd-content": "npx tsx scripts/generate-qmd-markdown.ts",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "preview": "vp preview",
    "seed:dorms": "npx tsx scripts/seed-dorms-table.ts",
    "submodule:init": "git submodule update --init --recursive",
    "submodule:update": "git submodule update --remote --merge",
    "sync:qmd": "npx tsx scripts/sync-qmd-index.ts",
    "typecheck": "tsc --noEmit",
    "validate:dorm-data": "npx tsx scripts/validate-dorm-data.ts",
    "postinstall": "git submodule update --init --recursive && git config --local include.path ../.gitconfig"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.22",
    "@headlessui/react": "^2.2.10",
    "@supabase/supabase-js": "^2.117.2",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "mapbox-gl": "^3.31.0",
    "rc-slider": "^11.1.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.4",
    "markdownlint-cli2": "^0.23.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2",
    "vite": "catalog:",
