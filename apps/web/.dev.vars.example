# ===========================================
# Worker secrets for local development
# ===========================================
# Copy to `.dev.vars` and fill in real values. `.dev.vars` is gitignored;
# this template is not. `vp dev` reads `.dev.vars` for the Worker and
# `.env.local` for the Vite build, so they are filled separately.
#
# Every name below is a member of `Env` in `apps/web/worker/types.ts`.
# `ASSETS` is bound by Cloudflare and is not set here.
# Placeholders only — never commit a real key or URL.

# Supabase: verifies caller JWTs for /api/chat and /api/integrations.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Provider keys for the /api/chat agent. Without DEEPSEEK_API_KEY chat gets
# no answer; without TAVILY_API_KEY every web search returns an error.
# DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
# TAVILY_API_KEY=YOUR_TAVILY_API_KEY
