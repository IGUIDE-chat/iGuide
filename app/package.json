{
  "name": "illiniguide---uiuc-knowledge-base",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "audit:dorm-media": "npx tsx scripts/audit-dorm-media.ts",
    "build": "vite build",
    "dev": "vite",
    "generate:qmd-content": "npx tsx scripts/generate-qmd-markdown.ts",
    "lint:fix": "eslint src functions scripts --ext .ts,.tsx --fix",
    "lint": "eslint src functions scripts --ext .ts,.tsx",
    "preview": "vite preview",
    "style:fix": "prettier --write . && pnpm run style:md:fix",
    "style:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "style:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "style": "prettier --check . && pnpm run style:md",
    "submodule:init": "git submodule update --init --recursive",
    "submodule:update": "git submodule update --remote --merge",
    "sync:qmd": "npx tsx scripts/sync-qmd-index.ts",
    "typecheck": "tsc --noEmit",
    "validate:dorm-data": "npx tsx scripts/validate-dorm-data.ts",
    "postinstall": "pnpm run submodule:init && git config --local include.path ../.gitconfig"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@supabase/supabase-js": "^2.101.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.563.0",
    "mapbox-gl": "^3.21.0",
    "node": "^25.9.0",
    "pnpm": "^10.33.0",
    "rc-slider": "^11.1.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-map-gl": "^8.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260404.1",
    "@eslint/js": "^9.38.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.4.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.4.0",
    "markdownlint-cli2": "^0.22.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "puppeteer": "^24.40.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tailwindcss": "^4.2.2",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^6.4.1"
  }
}