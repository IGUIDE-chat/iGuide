# ===========================================
# 🔒 SECURE ENVIRONMENT VARIABLES EXAMPLE
# ===========================================
# ⚠️ SECURITY RULES:
# - VITE_ prefixed = Compiled to frontend (only for public keys!)
# - Non-prefixed = Server-side only (NEVER exposed to browser)
# - This file is .gitignored, never commit real keys here

# ===========================================
# Public Keys (Safe for Frontend - VITE_ prefix)
# ===========================================

# Supabase (Public keys are safe for frontend)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Mapbox Token (Public token is acceptable)
VITE_MAPBOX_TOKEN=your_mapbox_public_token

# Coze Bot ID (Public ID is safe)
VITE_COZE_BOT_ID=your_coze_bot_id

# Frontend RAG toggle: false keeps local browser RAG, true delegates retrieval to Worker tool-use chat
VITE_USE_TOOL_USE_RAG=false

# ===========================================
# 🔒 Sensitive Keys (No VITE_ prefix!)
# ===========================================
# These are handled by server/proxy, never exposed to frontend

# Coze API Token (Server-side / Dev proxy only)
COZE_API_TOKEN=your_coze_api_token

# DeepSeek API Key (Server-side only)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Tavily API Key (Server-side only)
TAVILY_API_KEY=your_tavily_api_key_here

# ===========================================
# How It Works
# ===========================================
# Development: Vite proxy uses server-side keys from this file
# Production: Backend proxy handles all sensitive API calls
# Frontend: Only uses VITE_ prefixed public variables
