{
    "name": "api-gateway",
    "version": "0.1.0",
    "description": "Cloudflare Worker API Gateway for IlliniGuide",
    "main": "src/index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "deploy:production": "wrangler deploy --env production",
        "tail": "wrangler tail",
        "types": "wrangler types",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write ."
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20241127.0",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.4.0",
        "pnpm": "^10.33.0",
        "prettier": "^3.8.1",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.58.0",
        "wrangler": "^3.94.0"
    }
}