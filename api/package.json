{
	"name": "api-gateway",
	"version": "0.1.0",
	"description": "Cloudflare Worker API Gateway for IlliniGuide",
	"main": "src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "wrangler dev --config wrangler.jsonc",
		"deploy": "wrangler deploy",
		"deploy:production": "wrangler deploy --env production",
		"tail": "wrangler tail",
		"types": "wrangler types",
		"lint": "eslint src --ext .ts",
		"lint:fix": "eslint src --ext .ts --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write ."
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260425.1",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.5.0",
		"pnpm": "^10.33.2",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0",
		"wrangler": "^4.85.0"
	}
}
