{
  "name": "@iguide/api",
  "version": "0.1.0",
  "description": "Cloudflare Worker API Gateway for IlliniGuide",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "test": "node --test --experimental-strip-types --loader ./src/test/loaders/md-loader.ts \"src/**/*.test.ts\"",
    "types": "wrangler types",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "style": "prettier --check .",
    "style:fix": "prettier --write ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260617.1",
    "@types/node": "^25.9.3",
    "oxlint": "^1.70.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.101.0"
  }
}
