{
  "name": "api-gateway",
  "version": "0.1.0",
  "description": "Cloudflare Worker API Gateway for IlliniGuide",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "test": "node --test --experimental-strip-types --loader ./src/test/loaders/md-loader.ts \"src/**/*.test.ts\"",
    "types": "wrangler types",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "style": "prettier --check .",
    "style:fix": "prettier --write ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "pnpm": "^11.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "wrangler": "^4.90.1"
  }
}
