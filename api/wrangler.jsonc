{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"build": {
		"watch_dir": "src"
	},
	"vars": {
		"EMBEDDING_MODEL": "multilingual-e5-small",
		"EMBEDDING_DIMENSIONS": "384",
		"USE_TOOL_USE_RAG": "false"
	},
	"env": {
		"production": {},
		"development": {}
	}
}