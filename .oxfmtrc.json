{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": false,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortTailwindcss": {},
  "sortPackageJson": false,
  "ignorePatterns": [
    "*.md",
    "node_modules",
    "pnpm-lock.yaml",
    "build",
    "dist",
    "*.env.*",
    "*.jsonc"
  ]
}
