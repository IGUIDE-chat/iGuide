{
  "name": "@iguide/data-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Supabase import, embedding-dimension and schema verification tooling",
  "type": "module",
  "scripts": {
    "import": "node --experimental-transform-types import-to-supabase.ts",
    "test": "node --experimental-transform-types --test import-to-supabase.test.ts",
    "validate:embeddings": "node --experimental-transform-types validate-embedding-dimensions.ts",
    "verify:schema": "bash verify-v2-schema.sh",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "~7.0.2"
  }
}
