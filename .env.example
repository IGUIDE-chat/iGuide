# IlliniGuide Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# API Keys
# ============================================

# DeepSeek API (for Global users)
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-deepseek-your-key-here

# SiliconFlow API (for China users)
# Get from: https://siliconflow.cn/
SILICONFLOW_API_KEY=sk-siliconflow-your-key-here

# Tavily Search API (optional, for web search)
# Get from: https://tavily.com/
TAVILY_API_KEY=tvly-your-key-here

# ============================================
# Supabase Configuration
# ============================================
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Backend Configuration
# ============================================
# For local development
BACKEND_URL=http://localhost:8000/api/v1/chat

# For production (Argo Tunnel)
# BACKEND_URL=https://backend.iguide.chat/api/v1/chat

# ============================================
# Database Paths (auto-configured)
# ============================================
# These are set automatically by config.py
# KNOWLEDGE_DB_PATH=./knowledge.db
# MODEL_PATH=./backend/models
