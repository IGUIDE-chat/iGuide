# Supabase
VITE_SUPABASE_URL=your_project_url
VITE_SUPABASE_ANON_KEY=your_anon_key

# Coze API (Server-side preferred)
COZE_API_TOKEN=your_coze_api_token
COZE_BOT_ID=your_coze_bot_id
# Optional local-only keys if you still use direct /api/coze proxy in Vite dev:
# VITE_COZE_API_KEY=your_local_dev_coze_api_key
# VITE_COZE_BOT_ID=your_local_dev_coze_bot_id

# DeepSeek API Configuration (Server-side only, do NOT prefix with VITE_)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Mapbox Token (For Modern Map with Building Labels)
# Get your free token at: https://www.mapbox.com/
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here
