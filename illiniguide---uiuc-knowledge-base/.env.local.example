# ==========================================
# DIFY API CONFIGURATION
# ==========================================
# Get your Dify API key from: https://cloud.dify.ai
# After creating your app, go to "API Access" tab
VITE_DIFY_API_KEY=app-your-api-key-here
VITE_DIFY_API_BASE=https://api.dify.ai/v1

# ==========================================
# LEGACY COZE CONFIGURATION (Optional)
# ==========================================
# Keep these if you want to switch back to Coze
# VITE_COZE_API_KEY=your-coze-key
# VITE_COZE_BOT_ID=your-bot-id

# ==========================================
# INSTRUCTIONS
# ==========================================
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual API keys
# 3. Never commit .env.local to version control
# 4. See migration-guide.md for detailed setup instructions
