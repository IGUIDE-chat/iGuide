# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# API Gateway Configuration
# ============================================
# Worker gateway at api.iguide.chat
# For local development, use localhost if Worker is running locally
# VITE_BACKEND_URL=http://localhost:8787/chat

# For production (Worker gateway)
VITE_BACKEND_URL=https://api.iguide.chat/chat

# ============================================
# Optional: Coze Configuration (if using)
# ============================================
VITE_COZE_API_KEY=
VITE_COZE_BOT_ID=

# ============================================
# Backend Configuration
# ============================================
# For local development
# VITE_BACKEND_URL=http://localhost:8000/api/v1/chat

# For production (Argo Tunnel URL)
VITE_BACKEND_URL=https://api.illiniguide.com/api/v1/chat

# ============================================
# Optional: Coze Configuration (if using)
# ============================================
VITE_COZE_API_KEY=
VITE_COZE_BOT_ID=

# ============================================
# Optional: Feature Flags
# ============================================
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=false
